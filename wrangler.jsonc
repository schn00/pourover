{
  // The name must match the Worker name in the Cloudflare dashboard.
  "name": "pourover",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Workers AI, for reading bag photos and product pages.
  "ai": { "binding": "AI" },

  // SETUP.md step 1: paste the ID of the KV namespace you created.
  "kv_namespaces": [
    { "binding": "BREWLOG", "id": "a042fd6d371649db84a4f0f431dd152d" }
  ],

  // SETUP.md step 5: both values come from the Cloudflare Access setup.
   "vars": {
    "GOOGLE_CLIENT_ID": "373149418721-fr7bjf3eii5qoodjcmf7pktjvgnm8433.apps.googleusercontent.com"
  }
}
