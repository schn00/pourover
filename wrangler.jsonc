{
  // The name must match the Worker name in the Cloudflare dashboard.
  "name": "pourover",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // SETUP.md step 1: paste the ID of the KV namespace you created.
  "kv_namespaces": [
    { "binding": "BREWLOG", "id": "a042fd6d371649db84a4f0f431dd152d" }
  ],

  // SETUP.md step 5: both values come from the Cloudflare Access setup.
  "vars": {
    "TEAM_DOMAIN": "https://coresc.cloudflareaccess.com",
    "POLICY_AUD": "8e5a154e8c71a5d962673ab9c425d9af8cd2917a0700d1836109e158ffce0c45"
  }
}
